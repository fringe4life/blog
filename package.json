    "preview:cf": "astro build && wrangler dev"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/cloudflare": "14.3.2",
    "@astrojs/markdown-satteri": "^0.4.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/svelte": "9.0.1",
    "@vanilla-extract/css": "1.21.2",
    "@vanilla-extract/css-utils": "0.1.6",
    "astro": "7.3.3",
    "satteri": "0.10.5",
    "svelte": "5.57.1",
    "svelte-sonner": "1.2.1",
    "temml": "^0.13.5",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@antebudimir/eslint-plugin-vanilla-extract": "1.17.0",
    "@eslint/js": "10.0.1",
    "@vanilla-extract/vite-plugin": "5.2.6",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "prettier": "3.9.8",
    "prettier-plugin-astro": "1.0.1",
    "prettier-plugin-svelte": "4.1.1",
    "typescript-eslint": "8.70.0",
    "wrangler": "4.135.0"
  },
  "overrides": {
    "devalue": "5.9.4",
    "fast-uri": "3.1.8",
    "js-yaml": "4.3.2",
    "svgo": "4.1.0"
  }
