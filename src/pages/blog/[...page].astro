---
import Layout from "@/layouts/Layout.astro";
import type { GetStaticPaths } from "astro";
import {
  container,
  containerInline,
  gridWrapper,
} from "@/styles/utilities.css";
import BlogCard from "@/components/blog/BlogCard.astro";
import Pagination from "@/components/blog/Pagination.astro";
import BlogHero from "@/components/blog/BlogHero.astro";
import TagFilter from "@/components/blog/TagFilter.astro";
import {
  paginationOffsetTransition,
  paginationViewTransition,
} from "@/components/blog/pagination-transition.css";
import { BLOG_PAGE_SIZE, getPublishedBlog } from "@/lib/blog";

export const getStaticPaths = (async ({ paginate }) => {
  const sortedBlog = await getPublishedBlog();
  return paginate(sortedBlog, { pageSize: BLOG_PAGE_SIZE });
}) satisfies GetStaticPaths;

const {
  page: {
    data,
    currentPage,
    url: { next, prev },
  },
} = Astro.props;
---

<Layout title={`My Blog | page ${currentPage}`} description="Blog">
  <BlogHero currentPage={currentPage} />
  <TagFilter />
  <div class={container}>
    <div class={containerInline}></div>
    <section
      class={gridWrapper}
      transition:name={paginationViewTransition}
      transition:animate={paginationOffsetTransition}
    >
      {data.map((blog) => <BlogCard {...blog} />)}
    </section>
  </div>
  <Pagination prev={prev} next={next} />
</Layout>
